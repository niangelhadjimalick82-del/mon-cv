<script>
  // Tabs
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
      btn.classList.add('active');
      document.querySelector('.tab-panel[data-panel="'+btn.dataset.tab+'"]').classList.add('active');
    });
  });

  // Sidebar accordion (compétences)
  document.querySelectorAll('.sb-accordion-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      document.querySelector('.sb-accordion-panel[data-panel="'+btn.dataset.acc+'"]').classList.toggle('open', !open);
    });
  });

  // Projets accordion
  document.querySelectorAll('.proj-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      document.querySelector('.proj-panel[data-panelproj="'+btn.dataset.proj+'"]').classList.toggle('open', !open);
    });
  });
</script>

